{
    "server": {
        "description": "监听的服务器",
        "type": "string",
        "hint": "请输入Gotify服务器地址"
    },
    "token": {
        "description": "客户端token",
        "type": "string",
        "hint": "请输入client_token（非application_token）"
    },
    "bindings": {
        "description": "转发绑定",
        "type": "list",
        "hint": "将转发的群聊或私聊与Gotify应用名称绑定，必须绑定才会转发"
    },
    "reconnect_delay": {
        "description": "掉线重连延迟",
        "type": "int",
        "default": 30,
        "hint": "单位秒"
    }
}
